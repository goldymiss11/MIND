{
  "name": "mind-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:packages": "npm run --workspace=@mind/shared build && npm run --workspace=@mind/db build && npm run --workspace=@mind/ai build && npm run --workspace=@mind/memory build && npm run --workspace=@mind/core build && npm run --workspace=@mind/telegram build",
    "build": "npm run build:packages && npm run --workspaces --if-present build",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "npm run --workspaces --if-present test",
    "dev": "npm --workspace=@mind/api run dev",
    "dev:web": "npm --workspace=@mind/web run dev",
    "start": "npm --workspace=@mind/api run start",
    "start:web": "npm --workspace=@mind/web run start",
    "dev:worker": "npm --workspace=@mind/worker run dev",
    "start:worker": "npm --workspace=@mind/worker run start"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "docx": "^9.8.1"
  }
}
