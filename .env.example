# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# polling (default) or webhook. Webhook needs WEBHOOK_URL, or RENDER_EXTERNAL_URL on Render
TELEGRAM_BOT_MODE=polling
WEBHOOK_URL=
# Limits per user, protecting the shared free AI quotas
BOT_RATE_PER_MINUTE=10
BOT_RATE_PER_DAY=150
BOT_CONCURRENCY=4

# Database & Cache
DATABASE_URL=postgresql://user:password@host:5432/dbname
REDIS_URL=redis://localhost:6379

# AI Providers
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
OPEN_ROUTER_API=your_openrouter_api_key

# Server
PORT=3000
HOST=0.0.0.0

MINI_APP_URL=https://your-mini-app.example.com

# Admin Dashboard & Growth Tracking
# Required: the admin dashboard denies everyone when this is unset
ADMIN_SECRET=your_admin_secret_key
# Receives user feedback in Telegram and is exempt from the rate limits
ADMIN_TELEGRAM_ID=
NEXT_PUBLIC_BOT_USERNAME=mindopus_bot
